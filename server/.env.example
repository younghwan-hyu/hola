# --- HTTP ---
PORT=3000

# --- Provider credentials ---
OPENAI_KEY=sk-...
ANTHROPIC_KEY=sk-ant-...
GOOGLE_APPLICATION_CREDENTIALS=./google_service_account.json

# --- STT (bulk recognize) ---
STT_PROVIDER=google
STT_MODEL=latest_long
STT_LANGUAGE=ko-KR
# Optional: explicit sample rate. If unset, sdk infers from container header.
# STT_SAMPLE_RATE_HERTZ=48000

# --- AI (streaming) ---
AI_PROVIDER=openai          # openai | anthropic
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are a helpful assistant. Answer concisely in the user's language.
# OpenAI-only. one of: minimal | low | medium | high
# AI_OPENAI_REASONING=low
# Anthropic-only. thinking budget in tokens. omit to disable extended thinking.
# AI_ANTHROPIC_THINKING_BUDGET=1024

# --- TTS (streaming) ---
TTS_PROVIDER=google
TTS_VOICE=ko-KR-Chirp3-HD-Achernar
TTS_LANGUAGE=ko-KR
TTS_SAMPLE_RATE_HERTZ=24000
# PCM = raw int16 little-endian samples, decoded via Web Audio API (universal browser support).
# OGG_OPUS = compressed; clients need a JS Opus decoder since Chrome MSE doesn't accept OGG container.
TTS_AUDIO_ENCODING=PCM

# Sentence boundary punctuation for AI -> TTS queue split.
# Each character is one boundary. Defaults below cover EN/KO/CJK.
SENTENCE_BOUNDARY_CHARS=.,!?;:\n。，！？；：
