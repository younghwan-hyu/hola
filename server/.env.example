# --- HTTP ---
PORT=3000

# --- Provider credentials ---
OPENAI_KEY=sk-...
ANTHROPIC_KEY=sk-ant-...
GOOGLE_APPLICATION_CREDENTIALS=./google_service_account.json

# --- STT (bulk recognize) ---
STT_PROVIDER=google
STT_MODEL=latest_long
STT_LANGUAGE=ko-KR
# Optional: explicit sample rate. If unset, sdk infers from container header.
# STT_SAMPLE_RATE_HERTZ=48000

# --- AI (streaming) ---
AI_PROVIDER=openai          # openai | anthropic
# Camera feature sends images to the model, so AI_MODEL must support vision.
AI_MODEL=gpt-4o-mini
# OpenAI-only. one of: minimal | low | medium | high
# AI_OPENAI_REASONING=low
# Anthropic-only. thinking budget in tokens. omit to disable extended thinking.
# AI_ANTHROPIC_THINKING_BUDGET=1024

# --- TTS (streaming) ---
TTS_PROVIDER=google
TTS_VOICE=ko-KR-Chirp3-HD-Achernar
TTS_LANGUAGE=ko-KR
TTS_SAMPLE_RATE_HERTZ=24000
# PCM = raw int16 little-endian samples, decoded via Web Audio API (universal browser support).
# OGG_OPUS = compressed; clients need a JS Opus decoder since Chrome MSE doesn't accept OGG container.
TTS_AUDIO_ENCODING=PCM

# Sentence boundary punctuation for AI -> TTS queue split.
# Each character is one boundary. Defaults below cover EN/KO/CJK.
SENTENCE_BOUNDARY_CHARS=.,!?;:\n。，！？；：

# --- RAG (pgvector + self-hosted embeddings) ---
# Postgres (pgvector). compose overrides host to `db`; localhost is for `npm run dev`.
DATABASE_URL=postgres://hola:hola@localhost:5432/hola
# Self-hosted embedding server. Only `ollama` is supported.
EMBEDDINGS_PROVIDER=ollama
# compose overrides host to `embeddings`; localhost is for `npm run dev`.
EMBEDDINGS_URL=http://localhost:11434
# Embedding model tag served by Ollama. Default: KURE-v1 GGUF (Korean-retrieval
# specialized, 1024-dim, ~634MB). Alternative multilingual model: bge-m3
#   EMBEDDINGS_MODEL=bge-m3
# (also 1024-dim, so EMBEDDING_DIM stays 1024; re-upload documents after changing.)
# NOTE: this line only applies to local `npm run dev`. Under docker compose the
# model is set via the shell / project-root .env (compose overrides this), so the
# server and embeddings containers always agree — see compose.yml.
EMBEDDINGS_MODEL=hf.co/Bingsu/KURE-v1-Q8_0-GGUF
# Vector dimension the model emits. MUST match the model.
EMBEDDING_DIM=1024
# Document chunking (characters). Overlap must be < size.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# Default chunks returned by the search_documents tool.
RAG_TOP_K=5

# --- Tools ---
# Binary used to run python tools (get_weather spawns `<bin> tools/get_weather.py`).
# Defaults to python3 (plain `python` is absent on macOS and node:alpine).
# PYTHON_BIN=python3
